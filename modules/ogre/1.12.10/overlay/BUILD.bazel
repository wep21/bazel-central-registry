}

cc_library(
    name = "RenderSystem_GL3Plus_library",
    srcs = glob([
        "RenderSystems/GL3Plus/src/*.cpp",
        "RenderSystems/GL3Plus/src/GLSL/include/*.h",
        "RenderSystems/GL3Plus/src/GLSL/src/*.cpp",
    ]) + ["RenderSystems/GL3Plus/src/gl3w.c"],
