### Render systems

# Header-only target for code that talks to OGRE's GL render system directly
# (rviz_rendering does): the GL headers OGRE ships (including its bundled GLEW)
# plus the system GL headers they include.
cc_library(
    name = "RenderSystems",
    hdrs = glob([
        "RenderSystems/GL/include/**/*.h",
        "RenderSystems/GL/src/GLSL/include/**/*.h",
    ]),
    defines = [
        # OGRE's bundled GLEW is compiled into RenderSystem_GL; GLEW_NO_GLU
        # keeps glew.h from including <GL/glu.h>, which OGRE never uses.
        "GLEW_NO_GLU",
        "GLEW_STATIC",
    ],
    includes = [
        "RenderSystems/GL/include",
        "RenderSystems/GL/include/GL",
        "RenderSystems/GL/src",
    ],
    deps = [
        "@egl-registry//:EGL_headers",
        "@opengl-registry//:OpenGL_headers",
    ] + select({
        "@platforms//os:linux": [
            ":glx_headers",
            "@libx11",
        ],
        "//conditions:default": [],
    }),
)

# GL/glx.h is no longer part of the Khronos OpenGL-Registry; it is vendored
# from Mesa, like the gl.h that @opengl-registry vendors. glxext.h still comes
# from @opengl-registry.
cc_library(
    name = "glx_headers",
    hdrs = ["glx.h"],
    include_prefix = "GL",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:private"],
)

objc_library(
    name = "RenderSystem_GLSupport_osx_objc",
    hdrs = glob([
        "RenderSystems/GLSupport/include/*.h",
        "RenderSystems/GLSupport/include/GLSL/*.h",
        "RenderSystems/GLSupport/include/OSX/*.h",
    ]),
    copts = [
        "-fno-objc-arc",
        "-Wno-cast-qual",
        "-Wno-deprecated-declarations",
    ],
    includes = [
        "RenderSystems/GLSupport/include",
        "RenderSystems/GLSupport/include/GLSL",
        "RenderSystems/GLSupport/include/OSX",
    ],
    non_arc_srcs = glob(["RenderSystems/GLSupport/src/OSX/*.mm"]),
    sdk_frameworks = [
        "AppKit",
        "Cocoa",
        "CoreGraphics",
        "Foundation",
        "OpenGL",
        "QuartzCore",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:osx"],
    visibility = ["//visibility:private"],
    deps = [
        ":OgreMain_library",
        "@opengl-registry//:OpenGL_headers",
    ],
)

# Linked statically into both GL render system plugins, as upstream does.
cc_library(
