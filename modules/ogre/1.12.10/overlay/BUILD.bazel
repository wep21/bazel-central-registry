package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
)

exports_files([
    "CMake/Templates/resources.cfg.in",
    "LICENSE",
])

# OGRE's core media (RTShaderLib shaders, shadow volume and terrain materials,
# ...), which applications add as resource locations at runtime.
filegroup(
    name = "media",
    srcs = glob(["Media/**"]),
)

# Media of the samples. Upstream's unit tests (the test module in Tests/) load
# it through resources.cfg.
filegroup(
    name = "samples_media",
    srcs = glob(["Samples/Media/**"]),
)

# The build follows the CMake configuration ROS's rviz_ogre_vendor uses:
# shared libraries, OGRE_CONFIG_THREADS=0, OGRE_RESOURCEMANAGER_STRICT=2,
# OGRE_CONFIG_ENABLE_ZIP=ON, the GL and GL3Plus render systems, the STBI
# codec, and every component except Bites, HLMS and the language bindings.
#
# Each OGRE library is a `<name>_library` cc_library plus a `<name>`
# cc_shared_library, which is also what OGRE loads plugins as (Codec_STBI,
# RenderSystem_GL, RenderSystem_GL3Plus).

_LINUX_DL_LINKOPTS = select({
    "@platforms//os:linux": ["-ldl"],
    "//conditions:default": [],
})

# Public header sets, grouped the way OGRE's `make install` lays them out under
# include/OGRE/ (OgreMain at the top level; components, render systems and
# plugins in subdirectories), for packages that reproduce that install tree.
filegroup(
    name = "OgreMain_headers",
    srcs = glob(
        [
            "OgreMain/include/*.h",
            "OgreMain/include/Threading/*.h",
        ],
        exclude = [
            "OgreMain/include/OgreASTCCodec.h",
            "OgreMain/include/OgrePVRTCCodec.h",
        ],
    ) + [
        ":OgreBuildSettings_h",
        ":OgreComponents_h",
        ":OgreRTShaderConfig_h",
    ],
)

[
    filegroup(
        name = name + "_headers",
        srcs = glob(["Components/" + component + "/include/**/*.h"]),
    )
    for name, component in [
        ("OgreMeshLodGenerator", "MeshLodGenerator"),
        ("OgreOverlay", "Overlay"),
        ("OgrePaging", "Paging"),
        ("OgreProperty", "Property"),
        ("OgreRTShaderSystem", "RTShaderSystem"),
        ("OgreTerrain", "Terrain"),
        ("OgreVolume", "Volume"),
    ]
]

filegroup(
    name = "RenderSystem_GL_headers",
    srcs = glob(["RenderSystems/GL/include/**/*.h"]),
)

filegroup(
    name = "RenderSystem_GL3Plus_headers",
    srcs = glob(["RenderSystems/GL3Plus/include/**/*.h"]),
)

filegroup(
    name = "RenderSystem_GLSupport_headers",
    srcs = glob(["RenderSystems/GLSupport/include/*.h"]),
)

filegroup(
    name = "Codec_STBI_headers",
    srcs = glob(["PlugIns/STBICodec/include/*.h"]),
)

