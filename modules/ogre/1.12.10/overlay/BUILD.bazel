### OgreMain

_OGRE_MAIN_HDRS = glob(
    [
        "OgreMain/include/*.h",
        "OgreMain/include/Threading/*.h",
    ],
    exclude = [
        "OgreMain/include/OgreASTCCodec.h",
        "OgreMain/include/OgrePVRTCCodec.h",
    ],
) + [
    ":OgreBuildSettings_h",
    ":OgreComponents_h",
    ":OgreRTShaderConfig_h",
]

_OGRE_MAIN_COPTS = select({
    "@platforms//os:osx": [
        "-Wno-deprecated-declarations",
        "-Wno-implicit-const-int-float-conversion",
        "-Wno-inconsistent-missing-override",
    ],
    "//conditions:default": [],
})

objc_library(
    name = "OgreMain_osx_objc",
    hdrs = _OGRE_MAIN_HDRS + glob([
        "OgreMain/src/*.h",
        "OgreMain/src/OSX/*.h",
    ]),
    copts = _OGRE_MAIN_COPTS + [
        "-fno-objc-arc",
        "-std=c++17",
    ],
    includes = [
        "OgreMain/include",
        "OgreMain/include/Threading",
        "OgreMain/src",
        "OgreMain/src/OSX",
    ],
    non_arc_srcs = ["OgreMain/src/OSX/macUtils.mm"],
    sdk_frameworks = [
        "CoreFoundation",
        "Foundation",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:osx"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "OgreMain_library",
    srcs = glob(
        [
            "OgreMain/src/*.cpp",
            "OgreMain/src/*.h",
        ],
        exclude = [
            "OgreMain/src/OgreASTCCodec.cpp",
            "OgreMain/src/OgreFileSystemLayerNoOp.cpp",
            "OgreMain/src/OgrePVRTCCodec.cpp",
        ],
    ) + [
        "OgreMain/src/Threading/OgreDefaultWorkQueueStandard.cpp",
    ] + select({
        "@platforms//os:osx": glob([
            "OgreMain/src/OSX/*.cpp",
            "OgreMain/src/OSX/*.h",
        ]),
        "//conditions:default": glob(["OgreMain/src/GLX/*.cpp"]),
    }),
    hdrs = _OGRE_MAIN_HDRS,
    copts = _OGRE_MAIN_COPTS,
    implementation_deps = [
        "@zlib",
        "@zziplib",
    ],
    includes = [
        "OgreMain/include",
        "OgreMain/include/Threading",
        "OgreMain/src",
    ] + select({
        "@platforms//os:osx": ["OgreMain/src/OSX"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
        ],
        "@platforms//os:osx": [
            "-framework",
            "CoreFoundation",
            "-framework",
            "Foundation",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:osx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = select({
        "@platforms//os:osx": [":OgreMain_osx_objc"],
        "//conditions:default": [],
    }),
)

# zlib is linked into OgreMain (for OgreDeflate and the zip archive) and
# exported from it, so that the libraries depending on OgreMain that also need
# zlib (Codec_STBI, and OgreOverlay through freetype) do not link a second copy.
cc_shared_library(
    name = "OgreMain",
    exports_filter = [":OgreMain_library"] + select({
        "@platforms//os:osx": [":OgreMain_osx_objc"],
        "//conditions:default": [],
    }),
    deps = [
        ":OgreMain_library",
        "@zlib",
    ],
)

