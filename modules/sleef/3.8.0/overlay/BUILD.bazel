# Bazel build of SLEEF's vectorized math library (libsleef), following
# src/libm/CMakeLists.txt and Configure.cmake for x86_64 and AArch64 targets.
#
# The code generators (mkrename, mkalias, mkdisp) are host tools, so
# cross-compiling works between any (host, target) pair. The GNU ABI, scalar,
# quad precision (libsleefquad), DFT and inline-header libraries are not built.
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(
    ":sleef.bzl",
    "SLEEF_BUILTIN_MATH_DEFINES",
    "SLEEF_COPTS",
    "SLEEF_DEFINES",
    "sleef_concat",
    "sleef_extension_copts",
    "sleef_generate",
)

package(default_package_metadata = [":package_metadata"])

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:BSL-1.0",
    text = "LICENSE.txt",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

exports_files([
    "LICENSE.txt",
    # For the test module (src/libm-tester).
    "src/common/main_checkfeature.c",
])

# -----------------------------------------------------------------------------
# Target platforms
# -----------------------------------------------------------------------------

config_setting(
    name = "x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "x86_64_msvc",
    constraint_values = ["@platforms//cpu:x86_64"],
    flag_values = {"@rules_cc//cc/compiler:compiler": "msvc-cl"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "x86_64_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

# Configure.cmake disables SVE on Darwin.
config_setting(
    name = "aarch64_linux",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# Host code generators
# -----------------------------------------------------------------------------

[
    cc_binary(
        name = tool,
        srcs = [
            "src/libm/funcproto.h",
            "src/libm/{}.c".format(tool),
        ],
        copts = select({
            "@rules_cc//cc/compiler:msvc-cl": [],
            "//conditions:default": ["-std=gnu99"],
        }),
        # Its main() is called by bazel/tool_main.c, which redirects stdout.
        local_defines = ["main=sleef_tool_main"],
        deps = ["//bazel:tool_main"],
    )
    for tool in [
        "mkalias",
        "mkdisp",
        "mkrename",
    ]
]

