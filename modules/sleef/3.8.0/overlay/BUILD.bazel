_ARCHS = {
    "aarch64": (_AARCH64_EXTENSIONS, _AARCH64_HEADER_SECTIONS),
    "x86_64": (_X86_64_EXTENSIONS, _X86_64_HEADER_SECTIONS),
}

# The extensions that every architecture builds.
_PUREC_EXTENSIONS = [
    "PUREC_SCALAR",
    "PURECFMA_SCALAR",
]

# The extensions that are not built everywhere on their architecture: SVE is
# disabled on Darwin, and FMA4 is left out with MSVC (Configure.cmake only
# enables it if the compiler accepts _mm256_macc_pd).
_OPTIONAL_EXTENSIONS = {
    "FMA4": select({
        ":x86_64_msvc": ["@platforms//:incompatible"],
        "//conditions:default": ["@platforms//cpu:x86_64"],
    }),
    "SVE": [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    "SVENOFMA": [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
}

# The target_compatible_with of the libraries of each extension.
_EXTENSION_COMPATIBILITY = {
    extension: ["@platforms//cpu:" + arch]
    for arch, (extensions, _) in _ARCHS.items()
    for extension in extensions
} | {
    extension: []
    for extension in _PUREC_EXTENSIONS
} | _OPTIONAL_EXTENSIONS

# -----------------------------------------------------------------------------
# Generated headers
# -----------------------------------------------------------------------------

expand_template(
    name = "sleeflibm_header",
    out = "gen/sleeflibm_header.h.org",
    substitutions = {
        "@SLEEF_VERSION_MAJOR@": "3",
        "@SLEEF_VERSION_MINOR@": "8",
        "@SLEEF_VERSION_PATCH@": "0",
    },
    template = "src/libm/sleeflibm_header.h.org.in",
)

# The sections of sleef.h, per architecture.
[
    sleef_generate(
        name = "sleeflibm_{}_{}".format(arch, section),
        out = "gen/{}/sleeflibm_{}.h.tmp".format(arch, section),
        arguments = arguments or extensions[section][0],
        tool = ":mkrename",
    )
    for arch, (extensions, sections) in _ARCHS.items()
    for section, arguments in sections
]

sleef_concat(
    name = "sleef_h",
    srcs = [":sleeflibm_header"] + select({
        ":" + arch: [
            ":sleeflibm_{}_{}".format(arch, section)
            for section, _ in sections
        ]
        for arch, (_, sections) in _ARCHS.items()
    }) + ["src/libm/sleeflibm_footer.h.org"],
    out = "include/sleef.h",
)

# rename<extension>.h for every extension, and the headers renaming the
# dispatchers' functions.
[
    sleef_generate(
        name = "rename" + extension.lower(),
        out = "gen/rename{}.h".format(extension.lower()),
        arguments = rename_arguments,
        tool = ":mkrename",
    )
    for extension, (_, rename_arguments, _) in (_X86_64_EXTENSIONS | _AARCH64_EXTENSIONS).items()
]

[
    sleef_generate(
        name = "renamed" + name,
        out = "gen/renamed{}.h".format(name),
        arguments = arguments,
        tool = ":mkrename",
    )
    for name, arguments in {
        "sp128": [
            "-",
            "2",
            "4",
        ],
        "sp256": [
            "-",
            "4",
            "8",
        ],
        "spscalar": [
            "-",
            "1",
            "1",
        ],
    }.items()
]

# alias_<extension>.h: functions without the extension suffix (e.g.
# Sleef_expf4_u10 for Sleef_expf4_u10advsimd), for the extensions that have
# no dispatcher.
[
    [
        sleef_generate(
            name = "alias_{}_{}".format(extension, precision),
            out = "gen/alias_{}_{}.h.tmp".format(extension, precision),
            arguments = arguments,
            tool = ":mkalias",
        )
        for precision, arguments in [
            (
                "dp",
                alias[0],
            ),
            (
                "sp",
                alias[1],
            ),
        ]
    ] + [
        sleef_concat(
            name = "alias_" + extension.lower(),
            srcs = [
                ":alias_{}_sp".format(extension),
                ":alias_{}_dp".format(extension),
            ],
            out = "gen/alias_{}.h".format(extension.lower()),
        ),
    ]
    for extension, (_, _, alias) in (_X86_64_EXTENSIONS | _AARCH64_EXTENSIONS).items()
    if alias
]

# The private headers of the library: its sources' and the generated ones.
# The libraries use them as implementation_deps, so that only sleef.h reaches
# users. Public for the test module (src/libm-tester), whose programs include
# them like upstream's do.
cc_library(
    name = "internal_headers",
    hdrs = glob([
        "src/arch/*.h",
        "src/common/*.h",
        "src/libm/*.h",
    ]) + [
        ":rename" + extension.lower()
        for extension in (_X86_64_EXTENSIONS | _AARCH64_EXTENSIONS)
    ] + [
        ":alias_advsimd",
        ":alias_avx512f",
        ":renamedsp128",
        ":renamedsp256",
        ":renamedspscalar",
    ],
    includes = [
        "gen",
        "src/arch",
        "src/common",
        "src/libm",
    ],
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

cc_library(
    name = "headers",
    hdrs = [":sleef_h"],
    # Without it, Windows builds declare the functions __declspec(dllimport).
    defines = ["SLEEF_STATIC_LIBS=1"],
    includes = ["include"],
)

# -----------------------------------------------------------------------------
# libsleef
# -----------------------------------------------------------------------------

# libsleef is split into libraries by the flags its objects are built with,
# and each library depends on those it calls into, so that linkers that
# resolve static libraries in order (GNU ld) find every symbol. They are only
# linked statically (linkstatic), since the objects of upstream's single
# libsleef also use each other's hidden (NOEXPORT) symbols.

# The parts of libsleef that the functions of the extensions use: the tables
# of rempitab.c (built like TARGET_LIBSLEEF's own sources) and the CPU
# detection of common.c (TARGET_LIBCOMMON_OBJ).
cc_library(
    name = "rempitab",
    srcs = ["src/libm/rempitab.c"],
    copts = SLEEF_COPTS,
    implementation_deps = [":internal_headers"],
    linkstatic = True,
    local_defines = SLEEF_DEFINES + SLEEF_BUILTIN_MATH_DEFINES + ["DORENAME=1"] + select({
        ":x86_64_linux": ["ENABLEFLOAT128=1"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "common",
    srcs = ["src/common/common.c"],
    copts = SLEEF_COPTS,
    implementation_deps = [":internal_headers"],
    linkstatic = True,
)

# The functions of every extension, in their regular and DETERMINISTIC
# variants.
[
    cc_library(
        name = "sleef_{}{}".format(
            extension.lower(),
            "_det" if deterministic else "",
        ),
        srcs = [
            "src/libm/sleefsimddp.c",
            "src/libm/sleefsimdsp.c",
        ] + ([":alias_" + extension.lower()] if alias else []),
        copts = SLEEF_COPTS + sleef_extension_copts(extension),
        implementation_deps = [":internal_headers"],
        linkstatic = True,
        local_defines = SLEEF_DEFINES + SLEEF_BUILTIN_MATH_DEFINES + [
            "DORENAME=1",
            "ENABLE_{}=1".format(extension),
        ] + (["DETERMINISTIC=1"] if deterministic else []) + (
            # Bazel tokenizes defines like a shell, so the quotes are escaped.
            ['ALIAS_NO_EXT_SUFFIX=\\"alias_{}.h\\"'.format(extension.lower())] if alias else []
        ),
        target_compatible_with = _EXTENSION_COMPATIBILITY[extension],
        deps = [
            ":common",
            ":rempitab",
        ],
    )
    for extension, (_, _, alias) in (_X86_64_EXTENSIONS | _AARCH64_EXTENSIONS).items()
    for deterministic in [
        False,
        True,
    ]
]

# The libraries of the extensions, in both variants.
_LIBRARIES = {
    extension: [
        ":sleef_" + extension.lower(),
        ":sleef_{}_det".format(extension.lower()),
    ]
    for extension in _X86_64_EXTENSIONS | _AARCH64_EXTENSIONS
}

# The dispatchers, which pick the best extension of a vector width at runtime.
sleef_generate(
    name = "dispscalar_body",
    out = "gen/dispscalar.c.body",
    arguments = [
        "1",
        "1",
        "double",
        "float",
        "int32_t",
        "purec",
        "purecfma",
        "x",
    ],
    tool = ":mkdisp",
)

sleef_concat(
    name = "dispscalar_c",
    srcs = [
        # do not sort
        "src/libm/dispscalar.c.org",
        ":dispscalar_body",
        "src/libm/dispscalar_footer.c.org",
    ],
    out = "gen/dispscalar.c",
)

cc_library(
    name = "dispscalar",
    srcs = [":dispscalar_c"],
    copts = SLEEF_COPTS,
    implementation_deps = [":internal_headers"],
    linkstatic = True,
    local_defines = SLEEF_DEFINES,
    deps = _LIBRARIES["PUREC_SCALAR"] + _LIBRARIES["PURECFMA_SCALAR"],
)

# DISPATCHER_DEFINITIONS: the extensions that are built.
_DISPATCHER_DEFINES = ["ENABLE_AVX2=1"] + select({
    ":x86_64_msvc": [],
    "//conditions:default": ["ENABLE_FMA4=1"],
})

_FMA4_LIBRARIES = select({
    ":x86_64_msvc": [],
    "//conditions:default": _LIBRARIES["FMA4"],
})

[
    [
        sleef_generate(
            name = "disp{}_body".format(name),
            out = "gen/disp{}.c.tmp".format(name),
            arguments = arguments,
            tool = ":mkdisp",
        ),
        sleef_concat(
            name = "disp{}_c".format(name),
            srcs = [
                "src/libm/disp{}.c.org".format(name),
                ":disp{}_body".format(name),
            ],
            out = "gen/disp{}.c".format(name),
        ),
        cc_library(
            name = "disp" + name,
            srcs = [":disp{}_c".format(name)],
            copts = SLEEF_COPTS + sleef_extension_copts(extension),
            implementation_deps = [":internal_headers"],
            linkstatic = True,
            local_defines = SLEEF_DEFINES + _DISPATCHER_DEFINES,
            target_compatible_with = ["@platforms//cpu:x86_64"],
            deps = [":common"] + libraries,
        ),
    ]
    for name, arguments, extension, libraries in [
        (
            "sse",
            [
                "2",
                "4",
                "__m128d",
                "__m128",
                "__m128i",
                "sse2",
                "sse4",
                "avx2128",
            ],
            "SSE2",
            _LIBRARIES["SSE2"] + _LIBRARIES["SSE4"] + _LIBRARIES["AVX2128"],
        ),
        (
            "avx",
            [
                "4",
                "8",
                "__m256d",
                "__m256",
                "__m128i",
                "avx",
                "fma4",
                "avx2",
            ],
            "AVX",
            _LIBRARIES["AVX"] + _LIBRARIES["AVX2"] + _FMA4_LIBRARIES,
        ),
    ]
]

cc_library(
    name = "sleef",
    srcs = select({
        # COMPILER_SUPPORTS_LONG_DOUBLE: a long double wider than 9 bytes,
        # and GCC vector extensions.
        ":x86_64_msvc": [],
        ":x86_64": ["src/libm/sleefld.c"],
        ":aarch64_linux": ["src/libm/sleefld.c"],
        "//conditions:default": [],
    }) + select({
        # COMPILER_SUPPORTS_FLOAT128: __float128.
        ":x86_64_linux": ["src/libm/sleefqp.c"],
