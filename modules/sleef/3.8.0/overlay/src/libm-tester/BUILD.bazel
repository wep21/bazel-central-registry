# tester, which runs the iut program that its first argument names.
cc_library(
    name = "tester",
    testonly = True,
    srcs = [
        "tester.c",
        "testerutil.c",
        "testerutil.h",
    ],
    copts = _COPTS + ["-Wno-unused-result"],
    local_defines = SLEEF_DEFINES + ["USEMPFR=1"],
    # It starts the iut program with fork() and execvp().
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = _DEPS + ["@mpfr"],
    alwayslink = True,
)

# The iut programs: (name, sources, compiler flags, definitions, where they
# are built).
_IUTS = [
    (
        "iut",
        ["iut.c"],
        [],
        [],
        [],
    ),
] + [
    (
        "iut{}{}".format(
            "y" if deterministic else "",
            extension.lower(),
        ),
        [
            "iutsimd.c",
            "@sleef//:src/common/main_checkfeature.c",
        ],
        sleef_extension_copts(extension),
        ["ENABLE_{}=1".format(extension)] + (["DETERMINISTIC=1"] if deterministic else []),
        compatibility,
    )
    for extension, (compatibility, _) in _EXTENSIONS.items()
    for deterministic in [
        False,
        True,
    ]
] + [
    (
        "iut" + name,
        [
            "iutsimd.c",
            "@sleef//:src/common/main_checkfeature.c",
        ],
        sleef_extension_copts(extension),
        ["ENABLE_{}=1".format(name.upper())],
        ["@platforms//cpu:x86_64"],
    )
    for name, extension in {
        "dsp128": "SSE2",
        "dsp256": "AVX",
    }.items()
]

[
    [
        cc_binary(
            name = name + "_bin",
            testonly = True,
            srcs = srcs + [
                "testerutil.c",
                "testerutil.h",
            ],
            copts = _COPTS + copts,
            local_defines = SLEEF_DEFINES + defines,
            target_compatible_with = compatibility,
            deps = _DEPS,
        ),
        cc_test(
            name = name,
            # tester runs execvp() with this path, which must contain a slash.
            args = ["./$(rootpath :{}_bin)".format(name)],
            data = [":{}_bin".format(name)],
            target_compatible_with = compatibility,
            deps = [":tester"],
        ),
    ]
    for name, srcs, copts, defines, compatibility in _IUTS
]

[
    cc_test(
        name = "tester3" + extension.lower(),
        srcs = [
            "tester3.c",
            "testerutil.c",
            "testerutil.h",
            "@sleef//:src/common/main_checkfeature.c",
        ],
        args = ["$(rootpath :hash_{}.txt)".format("cinz" if "ATR=cinz_" in definitions else "finz")],
        copts = _COPTS + sleef_extension_copts(extension),
        data = [":hash_{}.txt".format("cinz" if "ATR=cinz_" in definitions else "finz")],
        local_defines = SLEEF_DEFINES + definitions,
        target_compatible_with = compatibility,
        deps = _DEPS + ["@openssl//:crypto"],
    )
    for extension, (compatibility, definitions) in _EXTENSIONS.items()
    if definitions
]
